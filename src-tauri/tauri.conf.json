{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pouch",
  "mainBinaryName": "pouch",
  "version": "2.1.0",
  "identifier": "com.leelib.pouch",
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
