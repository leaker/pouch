    "resources": {
      "../hook.conf.toml": "sample/hook.conf.toml",
      "../inject/global.js": "sample/inject/global.js",
      "../inject/www.leelib.com/leelib.js": "sample/inject/www.leelib.com/leelib.js"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
